# ---------------------------------------------------------------------------
# Copy this file to `backend/.env` and fill in your key.
# `.env` is git-ignored -- never commit real keys, and never put a key in the
# frontend (every LLM call in this project happens on the server).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Which LLM provider to use.
#
#   auto      -> whichever key below is filled in (Anthropic preferred)
#   anthropic -> Claude. Best output quality. Paid.
#   groq      -> open models on Groq. Generous free tier.
#
# You only need ONE of the two keys. Everything else in the app -- extraction,
# chunking, embeddings, vector search -- runs locally and needs no key at all.
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto

# --- Option A: Anthropic (https://console.anthropic.com/) ------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# --- Option B: Groq, free tier (https://console.groq.com/keys) -------------
GROQ_API_KEY=
# gpt-oss-120b is the Groq model that reliably honours strict JSON schemas,
# which this backend depends on. Smaller models return schema-shaped but
# semantically wrong output -- don't swap this without testing.
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning effort for the heavier analysis calls: low | medium | high | xhigh | max
LLM_EFFORT=high
# Reasoning effort for cheap structured-extraction calls
LLM_EXTRACTION_EFFORT=medium

# ---------------------------------------------------------------------------
# Embeddings
#   auto  -> sentence-transformers if installed, otherwise the hashing embedder
#   local -> force sentence-transformers (fails loudly if missing)
#   hash  -> force the dependency-free hashing embedder
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Vector store
#   auto   -> chroma if installed, otherwise the NumPy cosine store
#   chroma -> force ChromaDB
#   numpy  -> force the built-in NumPy store
# ---------------------------------------------------------------------------
VECTOR_STORE=auto

# ---------------------------------------------------------------------------
# Chunking + retrieval knobs (tune these to see how RAG behaves)
# ---------------------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8

# ---------------------------------------------------------------------------
# Upload safety
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=8

# ---------------------------------------------------------------------------
# Privacy: sessions (and the text extracted from uploads) are deleted after
# this many hours. Set to 0 to disable automatic cleanup.
# ---------------------------------------------------------------------------
SESSION_TTL_HOURS=24

# ---------------------------------------------------------------------------
# CORS: comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
