# The frontend needs no configuration for local development.
#
# Vite proxies every /api/* request to http://localhost:8000 (see
# vite.config.js), so there is no API base URL to set and no secret to leak.
#
# Only set this if you deploy the frontend and backend to different origins.
# VITE_API_BASE=https://your-backend.example.com
#
# NOTE: never put ANTHROPIC_API_KEY here. Anything in a VITE_* variable is
# compiled into the JavaScript bundle and visible to every visitor. The API key
# belongs in backend/.env and nowhere else.
